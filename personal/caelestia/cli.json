{
  "dots": {
    "url": "https://github.com/alvaro9rqc/caelestia.git",
    "branch": "personal"
  },
  "theme": {
    "enableTerm": true,
    "postHook": "$HOME/dotfiles/scripts/caelestia-theme-reload"
  },
  "toggles": {
    "todo": {
      "notion": {
        "enable": true,
        "desktop": "notion",
        "match": [
          {
            "initialTitle": "Notion"
          }
        ],
        "command": [
          "caelestia-desktop",
          "launch",
          "notion"
        ],
        "move": true
      },
      "todoist": {
        "enable": false
      }
    }
  }
}
